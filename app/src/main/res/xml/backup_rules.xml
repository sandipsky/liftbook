<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier. allowBackup="false" already keeps LiftBook out of cloud backup; this
     says the same for any backup that asks: everything stays on this phone, and the JSON export
     is the backup (FR-6.3). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
