<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later (the manifest's allowBackup covers earlier versions).
     LiftBook is fully offline: nothing goes to a cloud backup, and the JSON export is the backup
     (FR-6.3). A device-to-device transfer never leaves the user's hands, so it copies everything. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
